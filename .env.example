SCRAPER_USER_AGENT=

# Supabase PostgreSQL connection fields
# DATABASE_URL may be used instead of the five DB_* fields.
DATABASE_URL=
DIRECT_DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Google Cloud Storage bucket names (authentication uses ADC)
GCS_RAW_BUCKET=
GCS_PROCESSED_BUCKET=
GCS_RUNS_BUCKET=
GCP_PROJECT_ID=

# Optional protected annotation UI execution (disabled unless explicitly enabled).
# Generate two separate random secrets of at least 32 characters; never commit them.
ANNOTATION_UI_ENABLED=0
ANNOTATION_UI_TOKEN=
FLASK_SECRET_KEY=
