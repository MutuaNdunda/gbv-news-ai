SCRAPER_USER_AGENT=

# Supabase PostgreSQL connection fields
# DATABASE_URL may be used instead of the five DB_* fields.
DATABASE_URL=
DIRECT_DATABASE_URL=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# Google Cloud Storage bucket names (authentication uses ADC)
GCS_RAW_BUCKET=
GCS_PROCESSED_BUCKET=
GCS_RUNS_BUCKET=
GCP_PROJECT_ID=

# Optional protected annotation UI execution (disabled unless explicitly enabled).
# Generate two separate random secrets of at least 32 characters; never commit them.
ANNOTATION_UI_ENABLED=0
ANNOTATION_UI_TOKEN=
FLASK_SECRET_KEY=

# Optional local-only Human Review; no remote reviewer authentication yet.
HUMAN_REVIEW_ENABLED=0
HUMAN_REVIEW_TOKEN=
HUMAN_REVIEWER_ID=
HUMAN_REVIEW_GUIDELINE_VERSION=

# Optional L2: install a reviewed trained local artifact before model inference.
L2_BASE_MODEL=Davlan/afro-xlmr-base
L2_MODEL_PATH=
L2_MODEL_VERSION=
# UNVALIDATED ENGINEERING THRESHOLDS, not research acceptance thresholds.
L2_POSITIVE_THRESHOLD=0.8
L2_NEGATIVE_THRESHOLD=0.2
L2_BATCH_SIZE=8
L2_DEVICE=auto
